# My Dragon Bubble display translations.
msgid ""
msgstr "Language: en\nContent-Type: text/plain; charset=UTF-8\nMIME-Version: 1.0\nContent-Transfer-Encoding: 8bit\n"

msgid "设置"
msgstr "Settings"

msgid "外观与模型"
msgstr "Appearance"

msgid "选择你的桌面伙伴，或带来新的模样。"
msgstr "Choose your companion's look or import a new one."

msgid "行为与互动"
msgstr "Behavior"

msgid "调整小伙伴的活动习惯，了解互动方式。"
msgstr "Choose how your companion behaves and interacts."

msgid "桌面与显示"
msgstr "Desktop & display"

msgid "让桌宠以合适的大小，待在合适的位置。"
msgstr "Set your companion's size, screen and window position."

msgid "动作与适配"
msgstr "Motion & mapping"

msgid "识别角色能力，让每个动作都有合适的表现。"
msgstr "Preview animations and customize action mappings."

msgid "性能与画质"
msgstr "Performance"

msgid "调整清晰度、帧率与画面细节。"
msgstr "Adjust resolution, frame rate and visual detail."

msgid "你的桌面伙伴"
msgstr "Your desktop companion"

msgid "查找设置"
msgstr "Find a setting"

msgid "搜索外观、置顶、分辨率等设置"
msgstr "Search appearance, always on top, resolution and more"

msgid "没有匹配的设置"
msgstr "No matching settings"

msgid "界面语言"
msgstr "Display language"

msgid "退出桌宠"
msgstr "Exit"

msgid "更改自动保存"
msgstr "Changes saved automatically"

msgid "没有找到匹配项。\n请尝试“置顶”“外观”或“帧率”。"
msgstr "No matching settings.\nTry \"top\", \"appearance\" or \"FPS\"."

msgid "设置即时生效"
msgstr "Settings apply immediately"

msgid "当前伙伴"
msgstr "Your companion"

msgid "自定义桌宠外观，让它更合你的心意。"
msgstr "Make your companion feel more like you."

msgid "选择外观"
msgstr "Choose appearance"

msgid "导入新外观"
msgstr "Import appearance"

msgid "外观文件夹"
msgstr "Open skins folder"

msgid "直接选择 3D 模型、图片、GIF 或 skin.json。支持 GLB / glTF / FBX / OBJ / VRM；Blender、STL、PLY 文件可自动转换。"
msgstr "Select a 3D model, image, GIF or skin.json. Supports GLB / glTF / FBX / OBJ / VRM, with automatic conversion for Blender, STL and PLY."

msgid "日常活动"
msgstr "Daily activity"

msgid "自由散步"
msgstr "Roaming"

msgid "开启后，桌宠会随机走路、小跑、停留和休息。"
msgstr "Let your companion walk, run, pause and rest on its own."

msgid "和它互动"
msgstr "Interact with your companion"

msgid "轻点"
msgstr "Pet"

msgid "摸摸它，看看小小的回应。"
msgstr "Give it a little pat and watch its response."

msgid "左键单击"
msgstr "Left click"

msgid "提起与抛出"
msgstr "Pick up & throw"

msgid "松手后沿拖动方向滑行，再落到屏幕底部。"
msgstr "Release after dragging to let it glide and fall to the bottom of the screen."

msgid "拖动后松手"
msgstr "Drag and release"

msgid "快捷菜单"
msgstr "Quick settings"

msgid "快速切换外观、大小、散步和置顶。"
msgstr "Quickly change appearance, size, roaming and always on top."

msgid "右键单击"
msgstr "Right click"

msgid "关闭自由散步后，点击和拖动互动仍然可用。"
msgstr "Clicking and dragging still work when roaming is off."

msgid "桌宠始终置顶"
msgstr "Always on top"

msgid "开启后，桌宠显示在其他普通窗口上方；关闭后，其他窗口可以遮挡桌宠。"
msgstr "Keep your companion above other normal windows. Turn off to let other windows cover it."

msgid "所在显示器"
msgstr "Display"

msgid "选择显示器可立即移动桌宠。也可直接拖过屏幕边缘；相邻工作区之间支持惯性跨屏和散步。断开显示器后会自动找回。"
msgstr "Choose a display to move your companion, or drag it across a screen edge. It can roam and glide between adjoining work areas, and returns automatically if a display disconnects."

msgid "拖动滑块实时调节；也可输入百分比后按 Enter 应用。"
msgstr "Drag the slider, or enter a percentage and press Enter."

msgid "窗口与位置"
msgstr "Window & position"

msgid "找回桌宠"
msgstr "Bring companion back"

msgid "将它移回主屏幕右下角。"
msgstr "Move your companion to the bottom right of the primary display."

msgid "重置位置"
msgstr "Reset position"

msgid "位置会自动保存，下次启动时继续待在原来的地方。"
msgstr "The position is saved automatically and restored next time."

msgid "每种外观，独立适配"
msgstr "Settings for each appearance"

msgid "模型转换器"
msgstr "Model converter"

msgid "GLB、glTF、FBX、OBJ 和 VRM 无需外部软件。导入 .blend、STL、PLY 需要本机安装 Blender 4.2+，程序会自动查找，也可手动选择。"
msgstr "GLB, glTF, FBX, OBJ and VRM need no external software. Importing .blend, STL or PLY requires Blender 4.2+; it is detected automatically or can be selected below."

msgid "blender.exe 路径"
msgstr "Path to blender.exe"

msgid "浏览"
msgstr "Browse"

msgid "Blender 程序"
msgstr "Blender application"

msgid "选择 Blender 程序"
msgstr "Select Blender"

msgid "平面图片使用整体动作；骨骼与形态键使用模型自带动画。Live2D / Spine 工程请先导出为 GIF、精灵图或序列帧。VRM 当前保留基础网格、材质和骨架，不包含专用表情、MToon 和弹簧骨物理。"
msgstr "Images use whole-body motion; rigs and shape keys use the model's animations. Export Live2D / Spine projects as GIFs, sprite sheets or image sequences first. VRM keeps basic meshes, materials and rigs, without dedicated expressions, MToon or spring-bone physics."

msgid "请选择有效的 blender.exe 文件。"
msgstr "Select a valid blender.exe file."

msgid "%s · %d 个动画 · %d 根骨骼\n已匹配 %d / %d 个动作，其余由通用模组完成。\n在下方逐项预览或调整。"
msgstr "%s · %d animations · %d bones\n%d / %d actions mapped; the rest use generic motion.\nPreview or adjust each action below."

msgid "外观"
msgstr "Appearance"

msgid "%s · %d 个动画 · %d 根骨骼\n已匹配 %d / %d 个动作，其余使用通用模组。"
msgstr "%s · %d animations · %d bones\n%d / %d actions mapped; the rest use generic motion."

msgid "已识别 %d 个骨骼部位，缺少专用动作时可叠加轻量肢体动作。"
msgstr "%d rig parts detected. Lightweight limb motion can fill in missing animations."

