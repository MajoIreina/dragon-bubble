# Archived engine cache
/.godot/

# Local engines, scratch files, generated previews and release archives
/work/
/outputs/
/archives/

# Private Shu model, sources and textures stay on this computer.
/skins/shu/
/skins/
/source_models/
**/skins/shu/
*.blend
*.blend[0-9]*
*.import

# Independent macOS work is maintained on its existing port branch.
/macos/
/.github/workflows/macos.yml

# Python cache and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log

# Local credentials and Godot export secrets
.env
.env.*
!.env.example
export_credentials.cfg
/target/
*.pem
*.key
