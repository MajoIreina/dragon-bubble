config_version=5

[application]
config/name="My Dragon Bubble"
config/icon="res://assets/tray.svg"
config/windows_native_icon="res://assets/tray.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="LPPDesktopPet"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/minimum_display_time=0

[display]
window/size/viewport_width=320
window/size/viewport_height=320
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/size/resizable=false
window/per_pixel_transparency/allowed=true

[internationalization]
locale/translations=PackedStringArray("res://i18n/en.po", "res://i18n/ja.po")
locale/fallback="zh_CN"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.windows="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
