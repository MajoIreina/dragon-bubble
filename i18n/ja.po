# My Dragon Bubble display translations.
msgid ""
msgstr "Language: ja\nContent-Type: text/plain; charset=UTF-8\nMIME-Version: 1.0\nContent-Transfer-Encoding: 8bit\n"

msgid "设置"
msgstr "設定"

msgid "外观与模型"
msgstr "外観とモデル"

msgid "选择你的桌面伙伴，或带来新的模样。"
msgstr "デスクトップの仲間の外観を選ぶか、新しいモデルを追加します。"

msgid "行为与互动"
msgstr "ふるまいと交流"

msgid "调整小伙伴的活动习惯，了解互动方式。"
msgstr "仲間の行動や、ふれあい方を設定します。"

msgid "桌面与显示"
msgstr "デスクトップと表示"

msgid "让桌宠以合适的大小，待在合适的位置。"
msgstr "仲間のサイズ、表示画面、ウィンドウ位置を設定します。"

msgid "动作与适配"
msgstr "モーションと適用"

msgid "识别角色能力，让每个动作都有合适的表现。"
msgstr "アニメーションを確認し、動作の割り当てを調整します。"

msgid "性能与画质"
msgstr "パフォーマンス"

msgid "调整清晰度、帧率与画面细节。"
msgstr "解像度、フレームレート、描画の細かさを調整します。"

msgid "你的桌面伙伴"
msgstr "デスクトップの仲間"

msgid "查找设置"
msgstr "設定を検索"

msgid "搜索外观、置顶、分辨率等设置"
msgstr "外観、最前面、解像度などの設定を検索"

msgid "没有匹配的设置"
msgstr "一致する設定がありません"

msgid "界面语言"
msgstr "表示言語"

msgid "退出桌宠"
msgstr "終了"

msgid "更改自动保存"
msgstr "変更は自動保存されます"

msgid "没有找到匹配项。\n请尝试“置顶”“外观”或“帧率”。"
msgstr "一致する設定がありません。\n「最前面」「外観」「FPS」などをお試しください。"

msgid "设置即时生效"
msgstr "設定はすぐに反映されます"

msgid "当前伙伴"
msgstr "現在の仲間"

msgid "自定义桌宠外观，让它更合你的心意。"
msgstr "仲間の外観を好みに合わせて変えられます。"

msgid "选择外观"
msgstr "外観を選択"

msgid "导入新外观"
msgstr "外観をインポート"

msgid "外观文件夹"
msgstr "外観フォルダー"

msgid "直接选择 3D 模型、图片、GIF 或 skin.json。支持 GLB / glTF / FBX / OBJ / VRM；Blender、STL、PLY 文件可自动转换。"
msgstr "3D モデル、画像、GIF、skin.json を選択できます。GLB / glTF / FBX / OBJ / VRM に対応し、Blender、STL、PLY は自動変換できます。"

msgid "日常活动"
msgstr "日常の行動"

msgid "自由散步"
msgstr "自由に散歩"

msgid "开启后，桌宠会随机走路、小跑、停留和休息。"
msgstr "オンにすると、仲間が自由に歩いたり、小走りしたり、休んだりします。"

msgid "和它互动"
msgstr "仲間とふれあう"

msgid "轻点"
msgstr "なでる"

msgid "摸摸它，看看小小的回应。"
msgstr "軽くなでると、小さな反応を見せてくれます。"

msgid "左键单击"
msgstr "左クリック"

msgid "提起与抛出"
msgstr "持ち上げる・投げる"

msgid "松手后沿拖动方向滑行，再落到屏幕底部。"
msgstr "ドラッグして離すと、その方向に滑り、画面の下へ着地します。"

msgid "拖动后松手"
msgstr "ドラッグして離す"

msgid "快捷菜单"
msgstr "クイック設定"

msgid "快速切换外观、大小、散步和置顶。"
msgstr "外観、サイズ、散歩、最前面表示をすばやく変更できます。"

msgid "右键单击"
msgstr "右クリック"

msgid "关闭自由散步后，点击和拖动互动仍然可用。"
msgstr "自由に散歩をオフにしても、クリックやドラッグでふれあえます。"

msgid "桌宠始终置顶"
msgstr "常に最前面に表示"

msgid "开启后，桌宠显示在其他普通窗口上方；关闭后，其他窗口可以遮挡桌宠。"
msgstr "オンにすると、仲間をほかの通常ウィンドウより前に表示します。オフにすると、ほかのウィンドウの後ろにも表示されます。"

msgid "所在显示器"
msgstr "表示するディスプレイ"

msgid "选择显示器可立即移动桌宠。也可直接拖过屏幕边缘；相邻工作区之间支持惯性跨屏和散步。断开显示器后会自动找回。"
msgstr "ディスプレイを選ぶと仲間を移動できます。画面端を越えてドラッグすることもでき、隣接する作業領域の間を散歩したり滑ったりできます。画面の接続が切れると自動で戻ります。"

msgid "拖动滑块实时调节；也可输入百分比后按 Enter 应用。"
msgstr "スライダーで調整するか、割合を入力して Enter キーで適用します。"

msgid "窗口与位置"
msgstr "ウィンドウと位置"

msgid "找回桌宠"
msgstr "仲間を呼び戻す"

msgid "将它移回主屏幕右下角。"
msgstr "仲間をメイン画面の右下へ戻します。"

msgid "重置位置"
msgstr "位置をリセット"

msgid "位置会自动保存，下次启动时继续待在原来的地方。"
msgstr "位置は自動保存され、次回起動時にも引き継がれます。"

msgid "每种外观，独立适配"
msgstr "外観ごとの設定"

msgid "模型转换器"
msgstr "モデル変換"

msgid "GLB、glTF、FBX、OBJ 和 VRM 无需外部软件。导入 .blend、STL、PLY 需要本机安装 Blender 4.2+，程序会自动查找，也可手动选择。"
msgstr "GLB、glTF、FBX、OBJ、VRM は外部ソフト不要です。.blend、STL、PLY のインポートには Blender 4.2 以降が必要です。自動検出されない場合は、下で選択できます。"

msgid "blender.exe 路径"
msgstr "blender.exe のパス"

msgid "浏览"
msgstr "参照"

msgid "Blender 程序"
msgstr "Blender アプリケーション"

msgid "选择 Blender 程序"
msgstr "Blender を選択"

msgid "平面图片使用整体动作；骨骼与形态键使用模型自带动画。Live2D / Spine 工程请先导出为 GIF、精灵图或序列帧。VRM 当前保留基础网格、材质和骨架，不包含专用表情、MToon 和弹簧骨物理。"
msgstr "画像には全体の動きを、ボーンやシェイプキーにはモデルのアニメーションを使用します。Live2D / Spine は GIF、スプライトシート、連番画像に書き出してください。VRM は基本メッシュ、マテリアル、ボーンに対応し、専用表情、MToon、スプリングボーン物理は含みません。"

msgid "请选择有效的 blender.exe 文件。"
msgstr "有効な blender.exe を選択してください。"

msgid "%s · %d 个动画 · %d 根骨骼\n已匹配 %d / %d 个动作，其余由通用模组完成。\n在下方逐项预览或调整。"
msgstr "%s · アニメーション %d 個 · ボーン %d 本\n%d / %d 動作を割り当て済み。残りは汎用モーションです。\n下で各動作を確認・調整できます。"

msgid "外观"
msgstr "外観"

msgid "%s · %d 个动画 · %d 根骨骼\n已匹配 %d / %d 个动作，其余使用通用模组。"
msgstr "%s · アニメーション %d 個 · ボーン %d 本\n%d / %d 動作を割り当て済み。残りは汎用モーションです。"

msgid "已识别 %d 个骨骼部位，缺少专用动作时可叠加轻量肢体动作。"
msgstr "%d か所のボーン部位を検出。専用アニメーションがない場合は、軽い手足の動きを補えます。"

msgid "已启用 %d 处软体效果：身体自然下沉、腹部承托、移动惯性与弹性回稳。"
msgstr "%d か所のソフトボディ効果が有効です。自然なたわみ、腹部の支え、慣性、弾力のある復元を表現します。"

msgid "已识别 %d 个眨眼 / 微笑形态键，可在通用动作中使用。"
msgstr "まばたき・笑顔のシェイプキーを %d 個検出。汎用モーションで使用できます。"

msgid "动作风格"
msgstr "モーションの種類"

msgid "当前风格：%s。人物使用更轻的形变，软团使用更明显的弹性；自带动作播放时会减弱叠加形变。"
msgstr "現在の種類：%s。キャラクターは控えめに、柔らかい形のモデルは弾力を強めに変形します。モデル固有のアニメーション再生中は、追加の変形を弱めます。"

msgid "动作匹配与预览"
msgstr "動作の割り当てとプレビュー"

msgid "自动 · %s"
msgstr "自動 · %s"

msgid "通用动作"
msgstr "汎用モーション"

msgid "通用模组"
msgstr "汎用モーション"

msgid "%s：%s"
msgstr "%s：%s"

msgid "预览"
